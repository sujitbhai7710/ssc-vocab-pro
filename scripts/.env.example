# Required by scripts/generate-word-details.py (NVIDIA NIM API for qwen3-next-80b-a3b-instruct).
# Get your key at https://build.nvidia.com/settings/api-keys.
NVIDIA_API_KEY=nvapi-your-key-here

# (Optional) Override NVIDIA endpoint
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# (Optional) Override model
# NVIDIA_MODEL=qwen/qwen3-next-80b-a3b-instruct
